{
  "manifest_version": 3,
  "name": "GMGN Vamp",
  "description": "Correct token metadata and route configurable launch fees to holders from GMGN.",
  "version": "0.1.0",
  "permissions": ["storage", "scripting"],
  "icons": {
    "16": "assets/vamp-16.png",
    "32": "assets/vamp-32.png",
    "48": "assets/vamp-48.png",
    "128": "assets/vamp-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://bsc-dataseed.bnbchain.org/*",
    "https://funcs.flap.sh/*",
    "https://gmgn.ai/*",
    "https://app.long.xyz/*",
    "https://www.ponsfamily.com/*",
    "https://rpc.mainnet.chain.robinhood.com/*"
  ],
  "optional_host_permissions": ["https://*/*"],
  "content_scripts": [
    {
      "matches": ["https://gmgn.ai/*"],
      "js": ["route-observer.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://gmgn.ai/*"],
      "css": ["flap-tax-inspector.css"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://app.long.xyz/*"],
      "js": ["long-relay.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://app.long.xyz/create*"],
      "js": ["official-launch-prefill.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/vamp-128.png", "assets/flip-tax.png"],
      "matches": ["https://gmgn.ai/*"]
    }
  ]
}
