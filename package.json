{
  "name": "gmgn-vamp-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "package:extension": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-extension.ps1",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:focused": "playwright test tests/extension-shell.spec.ts tests/gmgn-production-adapter.spec.ts",
    "test:metadata": "playwright test tests/launch-metadata.spec.ts",
    "test:templates": "playwright test tests/template-management.spec.ts",
    "test:payment-assets": "playwright test tests/payment-assets.spec.ts tests/payment-asset-registry.contract.spec.ts tests/payment-asset-build.contract.spec.ts tests/registry-service.contract.spec.ts",
    "test:wallet": "playwright test tests/shared-wallet.spec.ts tests/flap-broadcast.spec.ts",
    "test:mechanics": "playwright test tests/launch-mechanics.spec.ts",
    "test:broadcast": "playwright test tests/flap-broadcast.contract.spec.ts tests/flap-hardening.contract.spec.ts tests/flap-broadcast.spec.ts tests/flap-erc20-browser.spec.ts",
    "smoke:readonly": "node scripts/smoke-readonly.mjs",
    "registry:start": "node registry/server.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/chrome": "0.0.326",
    "@types/node": "24.1.0",
    "esbuild": "0.25.8",
    "typescript": "5.9.2"
  },
  "dependencies": {
    "viem": "2.55.11"
  }
}
